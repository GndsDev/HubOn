COMPOSE_PROJECT_NAME=hubon

POSTGRES_DB=hubon_db
POSTGRES_USER=hubon_user
POSTGRES_PASSWORD=change-me

# Client web interface.
FRONTEND_PORT=4200

# Used only with docker-compose.dev.yml.
POSTGRES_PORT=5432
BACKEND_PORT=8080
JWT_SECRET=change-me-use-a-long-random-secret
HUBON_CORS_ALLOWED_ORIGINS=http://localhost:4200

HUBON_SEED_ENABLED=true
HUBON_SEED_OWNER_NAME=Proprietario
HUBON_SEED_OWNER_USERNAME=owner
HUBON_SEED_OWNER_PASSWORD=change-me
HUBON_SEED_ADMIN_ENABLED=true
HUBON_SEED_ADMIN_NAME=Administrador
HUBON_SEED_ADMIN_USERNAME=admin
HUBON_SEED_ADMIN_PASSWORD=change-me
